<mvc:View controllerName="bp.cust.ui.controller.Admin"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page showHeader="false" backgroundDesign="List" class="userMgmtPage">
        <content>
            <VBox class="umOuterPadding">

                <!-- ── Page Header ──────────────────────────────────── -->
                <HBox alignItems="Center" justifyContent="SpaceBetween" class="umPageHeader">
                    <HBox alignItems="Center">
                        <core:Icon src="sap-icon://group" size="2.5rem" color="#7B5EA7" class="umHeaderIcon" />
                        <VBox class="sapUiSmallMarginBegin">
                            <Title text="User Management" level="H2" class="umPageTitle" />
                            <Text text="Manage users, roles, and access requests" class="umPageSubtitle" />
                        </VBox>
                    </HBox>
                    <HBox>
                        <Button icon="sap-icon://action-settings" text="Configure Approval Levels" type="Transparent" press=".onConfigureApprovalLevels" class="umNavBtn sapUiSmallMarginEnd" />
                        <Button icon="sap-icon://inbox" text="Approval Inbox" type="Transparent" press=".onApprovalInbox" class="umNavBtn sapUiSmallMarginEnd" />
                        <Button icon="sap-icon://refresh" text="Refresh" type="Transparent" press=".onRefreshUsers" class="umRefreshBtn" />
                    </HBox>
                </HBox>

                <!-- ── Users Card ───────────────────────────────────── -->
                <VBox class="umCard sapUiMediumMarginTop">
                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="umCardHeader umCardHeaderUsers">
                        <HBox alignItems="Center">
                            <FlexBox justifyContent="Center" alignItems="Center" class="umCardIconCircle umIconUsers">
                                <core:Icon src="sap-icon://employee" size="1.2rem" color="#1565c0" />
                            </FlexBox>
                            <Title text="Users" level="H3" class="sapUiSmallMarginBegin" />
                        </HBox>
                        <Button icon="sap-icon://delete" text="Delete Selected" type="Transparent" press=".onDeleteUsers" class="umDeleteBtn" tooltip="Delete Selected Users" />
                    </HBox>

                    <Table id="userTable"
                        items="{ path: '/Users' }"
                        growing="true"
                        growingThreshold="20"
                        busyIndicatorDelay="0"
                        noDataText="No users registered yet."
                        mode="MultiSelect"
                        showSeparators="Inner"
                        class="umTable">
                        <columns>
                            <Column width="22%"><Text text="Name" /></Column>
                            <Column width="140px"><Text text="Role" /></Column>
                            <Column><Text text="Email" /></Column>
                            <Column width="110px" hAlign="Center"><Text text="Status" /></Column>
                            <Column width="170px"><Text text="Last Updated" /></Column>
                            <Column width="170px"><Text text="Approved By" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem class="umTableRow">
                                <cells>
                                    <HBox alignItems="Center">
                                        <FlexBox justifyContent="Center" alignItems="Center" class="umAvatar">
                                            <Text text="{= ${name} ? ${name}.charAt(0).toUpperCase() : '?' }" class="umAvatarText" />
                                        </FlexBox>
                                        <Text text="{name}" class="umUserName sapUiSmallMarginBegin" />
                                    </HBox>
                                    <Select selectedKey="{role}" change=".onUserRoleChange" class="umRoleSelect">
                                        <core:Item key="admin" text="Admin" />
                                        <core:Item key="viewer" text="Viewer" />
                                    </Select>
                                    <Text text="{email}" class="umEmailText" />
                                    <HBox justifyContent="Center">
                                        <Text
                                            text="{status}"
                                            class="{= ${status} === 'active' ? 'umStatusActive' : 'umStatusInactive' }" />
                                    </HBox>
                                    <Text text="{path: 'modifiedAt', formatter: '.formatDate'}" class="umDateText" />
                                    <HBox alignItems="Center">
                                        <core:Icon src="sap-icon://approvals" class="sapUiTinyMarginEnd" color="#7c4dff" />
                                        <Text text="{createdBy}" class="umDateText" />
                                    </HBox>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>

                <!-- ── Pending Requests Card ────────────────────────── -->
                <VBox class="umCard umCardWarning sapUiMediumMarginTop">
                    <HBox alignItems="Center" class="umCardHeader umCardHeaderPending">
                        <FlexBox justifyContent="Center" alignItems="Center" class="umCardIconCircle umIconPending">
                            <core:Icon src="sap-icon://pending" size="1.2rem" color="#e65100" />
                        </FlexBox>
                        <Title text="Pending Access Requests" level="H3" class="sapUiSmallMarginBegin" />
                    </HBox>

                    <Table id="pendingRequestsTable"
                        items="{ path: '/AccessRequests', filters: [{ path: 'status', operator: 'EQ', value1: 'pending' }] }"
                        showSeparators="Inner"
                        busyIndicatorDelay="0"
                        noDataText="No pending access requests."
                        class="umTable">
                        <columns>
                            <Column width="25%"><Text text="User" /></Column>
                            <Column width="140px" hAlign="Center"><Text text="Requested Role" /></Column>
                            <Column><Text text="Reason" /></Column>
                            <Column width="200px" hAlign="Center"><Text text="Actions" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem class="umTableRow">
                                <cells>
                                    <VBox>
                                        <Text text="{userName}" class="umUserName" />
                                        <Text text="{userEmail}" class="umEmailText" />
                                    </VBox>
                                    <HBox justifyContent="Center">
                                        <Text
                                            text="{requestedRole}"
                                            class="{= ${requestedRole} === 'admin' ? 'umRoleBadgeAdmin' : 'umRoleBadgeViewer' }" />
                                    </HBox>
                                    <Text text="{reason}" class="umReasonText" />
                                    <HBox justifyContent="Center" alignItems="Center">
                                        <Button text="Approve"
                                            icon="sap-icon://accept"
                                            press=".onApproveRequest"
                                            class="umApproveBtn sapUiTinyMarginEnd" />
                                        <Button text="Reject"
                                            icon="sap-icon://decline"
                                            press=".onRejectRequest"
                                            class="umRejectBtn" />
                                    </HBox>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>

                <!-- ── Request History Card ─────────────────────────── -->
                <VBox class="umCard sapUiMediumMarginTop sapUiMediumMarginBottom">
                    <HBox alignItems="Center" class="umCardHeader umCardHeaderHistory">
                        <FlexBox justifyContent="Center" alignItems="Center" class="umCardIconCircle umIconHistory">
                            <core:Icon src="sap-icon://history" size="1.2rem" color="#5c3d9e" />
                        </FlexBox>
                        <Title text="Request History" level="H3" class="sapUiSmallMarginBegin" />
                    </HBox>

                    <Table id="requestHistoryTable"
                        items="{ path: '/AccessRequests', filters: [{ path: 'status', operator: 'NE', value1: 'pending' }] }"
                        showSeparators="Inner"
                        busyIndicatorDelay="0"
                        noDataText="No request history."
                        class="umTable">
                        <columns>
                            <Column width="25%"><Text text="User" /></Column>
                            <Column width="140px" hAlign="Center"><Text text="Requested Role" /></Column>
                            <Column width="120px" hAlign="Center"><Text text="Status" /></Column>
                            <Column width="180px"><Text text="Updated" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem class="umTableRow">
                                <cells>
                                    <VBox>
                                        <Text text="{userName}" class="umUserName" />
                                        <Text text="{userEmail}" class="umEmailText" />
                                    </VBox>
                                    <HBox justifyContent="Center">
                                        <Text
                                            text="{requestedRole}"
                                            class="{= ${requestedRole} === 'admin' ? 'umRoleBadgeAdmin' : 'umRoleBadgeViewer' }" />
                                    </HBox>
                                    <HBox justifyContent="Center">
                                        <Text
                                            text="{status}"
                                            class="{= ${status} === 'approved' ? 'umStatusApproved' : 'umStatusRejected' }" />
                                    </HBox>
                                    <Text text="{path: 'modifiedAt', formatter: '.formatDate'}" class="umDateText" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
