<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog id="addMasterDataDialog" title="Add Master Data">
        <content>
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
                <f:content>
                    <Label text="Code" required="true" />
                    <Input id="newVHCode" placeholder="Enter code (e.g. ZP09)" />
                    <Label text="Name" required="true" />
                    <Input id="newVHName" placeholder="Enter descriptive name" />
                </f:content>
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button text="Add" type="Emphasized" press="onConfirmAddVH" />
        </beginButton>
        <endButton>
            <Button text="Cancel" press="onCloseAddVH" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
