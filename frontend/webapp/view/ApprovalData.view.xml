<mvc:View controllerName="bp.cust.ui.controller.ApprovalData"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core">
    <f:DynamicPage id="approvalDataPage" headerExpanded="true" showFooter="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Approval Data"/>
                </f:heading>
                <f:actions>
                    <Button text="Refresh" type="Transparent" icon="sap-icon://refresh" press=".onRefresh"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox>
                <Table id="approvedBPTable"
                    items="{approvedList>/}"
                    sticky="HeaderToolbar,ColumnHeaders"
                    autoPopinMode="true"
                    class="sapUiResponsiveMargin">

                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Approved Business Partners" level="H2"/>
                            <ToolbarSpacer />
                            <SearchField width="30%" search=".onSearch" placeholder="Search by name or ID..."/>
                        </OverflowToolbar>
                    </headerToolbar>

                    <columns>
                        <Column width="15%"><Text text="BP Reference Number" /></Column>
                        <Column width="22%"><Text text="Name" /></Column>
                        <Column width="10%"><Text text="Grouping" /></Column>
                        <Column width="10%"><Text text="Status" /></Column>
                        <Column width="18%"><Text text="SAP Push Status" /></Column>
                        <Column width="25%" hAlign="Center"><Text text="Push Data" /></Column>
                    </columns>

                    <items>
                        <ColumnListItem press=".onItemPress">
                            <cells>
                                <Text text="{approvedList>BusinessPartnerNumber}" />
                                <Title text="{approvedList>Name}" titleStyle="H6" />
                                <Text text="{approvedList>Grouping}" />
                                <ObjectStatus text="Approved" state="Success" icon="sap-icon://sys-enter-2" inverted="true" />
                                <HBox alignItems="Center">
                                    <ObjectStatus text="{approvedList>SAPPushStatus}"
                                        state="{= ${approvedList>SAPPushStatus} === 'Pushed' ? 'Success' : (${approvedList>SAPPushStatus} === 'Failed' ? 'Error' : 'None') }"
                                        inverted="true" />
                                    <Button icon="sap-icon://hint"
                                        visible="{= ${approvedList>SAPPushStatus} === 'Failed' || ${approvedList>SAPPushStatus} === 'Pushed' }"
                                        press=".onShowPushLogs"
                                        tooltip="View push logs"
                                        type="Transparent" />
                                </HBox>
                                <HBox justifyContent="Center" alignItems="Center">
                                    <Button icon="sap-icon://upload-to-cloud"
                                        type="Emphasized"
                                        tooltip="Push to SAP"
                                        width="100%"
                                        visible="{= ${approvedList>SAPPushStatus} !== 'Pushed' }"
                                        press=".onPushToSAP" />
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>