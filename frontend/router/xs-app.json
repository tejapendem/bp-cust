{
    "welcomeFile": "/bpcustui/index.html",
    "authenticationMethod": "route",
    "routes": [
        {
            "source": "^/user-api(.*)$",
            "target": "$1",
            "service": "sap-approuter-userapi"
        },

        {
            "source": "^/.*service/bpcust/(.*)$",
            "target": "service/bpcust/$1",
            "destination": "srv-api",
            "authenticationType": "xsuaa",
            "csrfProtection": true
        },
        {
            "source": "^(.*)$",
            "target": "$1",
            "service": "html5-apps-repo-rt",
            "authenticationType": "xsuaa"
        }
    ]
}