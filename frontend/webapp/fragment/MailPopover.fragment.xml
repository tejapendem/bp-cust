<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <ResponsivePopover id="mailPopover"
        title="Send Email to Approvers"
        class="sapUiPopupPadding">
        <content>
            <VBox>
                <Label text="Select recipients:" class="sapUiSmallMarginBottom" />
                <List id="mailRecipientList"
                    mode="MultiSelect"
                    items="{mailData>/emails}"
                    includeItemInSelection="true">
                    <StandardListItem title="{mailData>}" type="Active" />
                </List>
            </VBox>
        </content>
        <beginButton>
            <Button text="Send" type="Emphasized" press=".onSendMail" />
        </beginButton>
        <endButton>
            <Button text="Cancel" press="handlePopoverClose" />
        </endButton>
    </ResponsivePopover>
</core:FragmentDefinition>
