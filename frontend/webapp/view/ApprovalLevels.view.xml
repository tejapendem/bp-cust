<mvc:View controllerName="bp.cust.ui.controller.ApprovalLevels"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form">
    <Page title="Approval Workflow Configuration" showNavButton="true" navButtonPress=".onNavBack" backgroundDesign="List">
        <headerContent>
            <Button icon="sap-icon://refresh" text="Refresh" type="Transparent" press=".onRefresh" />
            <Button icon="sap-icon://add" text="Add New Level" type="Accept" press=".onAddLevel" />
        </headerContent>
        <content>
            <VBox class="sapUiSmallMargin">
                
                <VBox class="destinationDetailContainer shadowBox">
                    <Toolbar>
                        <Title text="Backend Approval Table Management" level="H3" />
                        <ToolbarSpacer />
                        <Button text="Save Changes" type="Emphasized" press=".onSave" icon="sap-icon://save" />
                    </Toolbar>
                    
                    <Table id="approvalTable" items="{ path: '/ApprovalLevels', sorter: { path: 'level' } }" mode="Delete" delete=".onDeleteLevel" class="sapUiNoContentPadding">
                        <columns>
                            <Column width="80px"><Text text="Level" /></Column>
                            <Column width="250px"><Text text="Workflow Step Name" /></Column>
                            <Column><Text text="Approver Name" /></Column>
                            <Column><Text text="Notification Email" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <ObjectStatus text="{level}" state="Information" inverted="true" />
                                    <Input value="{levelName}" placeholder="e.g. Finance Team Approval" />
                                    <Input value="{username}" placeholder="Enter name" />
                                    <Input value="{email}" type="Email" placeholder="user@gmail.com" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>

                <VBox class="sapUiMediumMarginTop destinationDetailContainer shadowBox">
                    <form:SimpleForm editable="false" layout="ResponsiveGridLayout" title="Communication Channel: Gmail SMTP">
                        <Label text="SMTP Status" />
                        <ObjectStatus text="Active" state="Success" icon="sap-icon://sys-enter-2" />
                        <Label text="System Email" />
                        <Text text="saiteja14419@gmail.com" />
                        <Label text="Notification Service" />
                        <Text text="Nodemailer (In-App Configuration)" />
                    </form:SimpleForm>
                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
