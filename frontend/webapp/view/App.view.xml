<mvc:View controllerName="bp.cust.ui.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <tnt:ToolPage id="toolPage">
        <tnt:header>
            <tnt:ToolHeader>
                <Button id="sideNavigationToggleButton" icon="sap-icon://menu2" type="Transparent" press=".onSideNavButtonPress" />
                <ToolbarSpacer width="10px" />
                <Image src="https://www.sap.com/dam/application/shared/logos/sap-logo-svg.svg" height="1.5rem" />
                <Title text="Business Partner" level="H1" />
                <ToolbarSpacer />
                <Button icon="sap-icon://bell" type="Transparent" />
                <Avatar id="profileAvatar" displaySize="XS" initials="{userModel>/initials}" press=".onProfilePress" class="sapUiSmallMarginEnd" />
            </tnt:ToolHeader>
        </tnt:header>
        <tnt:sideContent>
            <tnt:SideNavigation id="sideNavigation" selectedKey="home" itemSelect=".onItemSelect">
                <tnt:NavigationList>
                    <tnt:NavigationListItem text="Home" icon="sap-icon://home" key="home" visible="{userModel>/isRegistered}" />
                    <tnt:NavigationListItem text="Create Business Partner" icon="sap-icon://create" key="createBP" visible="{= ${userModel>/role} !== 'guest' &amp;&amp; ${userModel>/isRegistered} }" />
                    <tnt:NavigationListItem text="Admin Dashboard" icon="sap-icon://manager-insight" key="dashboard" visible="{userModel>/isAdmin}" />
                    <tnt:NavigationListItem text="Activation Queue" icon="sap-icon://activate" key="queue" visible="{userModel>/isAdmin}" />
                    <tnt:NavigationListItem text="User Management" icon="sap-icon://group" key="admin" visible="{userModel>/isAdmin}" />
                    <tnt:NavigationListItem text="Approval Workflow" icon="sap-icon://workflow-begin" key="approvalLevels" visible="{userModel>/isAdmin}" />
                    <tnt:NavigationListItem text="Approval Inbox" icon="sap-icon://InBox" key="approvalInbox" visible="{userModel>/isAdmin}" />
                </tnt:NavigationList>
            </tnt:SideNavigation>
        </tnt:sideContent>
        <tnt:mainContents>
            <App id="appContainer" />
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>
