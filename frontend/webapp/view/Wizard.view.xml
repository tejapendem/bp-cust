<mvc:View controllerName="bp.cust.ui.controller.Wizard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:mc="sap.suite.ui.microchart"
    height="100%">

    <Page id="wizardPage"
          title="{= ${wizardData>/isReadOnly} ? 'Business Partner Details' : 'Create Business Partner' }"
          showNavButton="true"
          navButtonPress="onNavBack"
          backgroundDesign="Solid">
        <headerContent>
            <Button text="Save as Draft" type="Ghost" icon="sap-icon://save" press="onSaveDraft" visible="{= !${wizardData>/isReadOnly} }" />
        </headerContent>
        <content>
            <VBox class="wizardRedBoxFrame sapUiMediumMargin">
                
                <HBox alignItems="Center" class="progressHeaderBox">
                    <mc:RadialMicroChart 
                        id="progressChart" 
                        size="M" 
                        percentage="{wizardData>/progress}" 
                        valueColor="{wizardData>/progressColor}"/>
                    <Title 
                        text="Completion Status: {wizardData>/progressText}" 
                        level="H3" 
                        class="sapUiMediumMarginBegin completionText"/>
                </HBox>

                <Wizard id="bpWizard"
                        complete="onWizardCompleted"
                        stepActivate="onStepActivate"
                        showNextButton="false"
                        renderMode="Page">

                    <WizardStep id="step1" title="Basic Info (000000)" icon="sap-icon://account" validated="true">
                        <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12" columnsXL="2" columnsL="2" columnsM="1">
                            <core:Title text="1. Basic Info"/>
                            
                            <Label text="BP Role"/>
                            <Input value="{wizardData>/BPRole}" editable="false"/>
                            
                            <Label text="Business Partner" required="true"/>
                            <Select id="categorySelect" selectedKey="{wizardData>/BusinessPartnerCategory}" items="{path: '/VH_BusinessPartnerCategory', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                <core:Item key="{code}" text="{name}"/>
                            </Select>

                            <Label text="BP Type" required="true"/>
                            <Select id="bpTypeSelect" selectedKey="{wizardData>/BPType}" items="{path: '/VH_BPType', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                <core:Item key="{code}" text="{name}"/>
                            </Select>
                            
                            <Label text="Grouping" required="true"/>
                            <Select id="groupingSelect" selectedKey="{wizardData>/Grouping}" items="{path: '/VH_Grouping', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }" change="onGroupingChange">
                                <core:Item key="{code}" text="{code} - {name}"/>
                            </Select>
                        </form:SimpleForm>
                        <HBox justifyContent="End" class="sapUiMediumMarginTop">
                            <Button text="Step 2" type="Emphasized" press="onNextStep" />
                        </HBox>
                    </WizardStep>

                    <WizardStep id="step2" title="Address Details" icon="sap-icon://map-2" validated="true">
                        <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12" columnsXL="2" columnsL="2" columnsM="1">
                            <core:Title text="Identity"/>
                            
                            <Label text="Title" required="true"/>
                            <Select selectedKey="{wizardData>/Title}" items="{path: '/VH_Title', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                <core:Item key="{code}" text="{code} - {name}"/>
                            </Select>

                            <Label text="Name" required="true"/>
                            <Input id="nameInput" value="{wizardData>/Name}" placeholder="Full / Company Name" editable="{= !${wizardData>/isReadOnly} }"/>
                            
                            <Label text="Search terms 1/2"/>
                            <HBox>
                                <Input value="{wizardData>/SearchTerm1}" placeholder="Term 1" editable="{= !${wizardData>/isReadOnly} }"/>
                                <Input value="{wizardData>/SearchTerm2}" placeholder="Term 2" class="sapUiSmallMarginBegin" editable="{= !${wizardData>/isReadOnly} }"/>
                            </HBox>
                            
                            <core:Title text="Location Details"/>

                            <Label text="Street Address"/>
                            <Input value="{wizardData>/StreetAddress}" placeholder="Street, Building, Floor" editable="{= !${wizardData>/isReadOnly} }"/>
                            
                            <Label text="Postal Code"/>
                            <Input value="{wizardData>/PostalCode}" placeholder="ZIP / Postal Code" editable="{= !${wizardData>/isReadOnly} }"/>

                            <Label text="Country" required="true"/>
                            <Select id="countrySelect" selectedKey="{wizardData>/Country}" items="{path: '/VH_Country', parameters: {$filter: 'isActive eq true'}}" change="onCountryChange" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                <core:Item key="{code}" text="{code} - {name}"/>
                            </Select>

                            <Label text="Region"/>
                            <Select id="regionSelect" selectedKey="{wizardData>/Region}" items="{path: '/VH_Region', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                <core:Item key="{code}" text="{name}"/>
                            </Select>

                            <core:Title text="Communication"/>

                            <Label text="Language"/>
                            <Select selectedKey="{wizardData>/Language}" items="{path: '/VH_Language', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                <core:Item key="{code}" text="{code} - {name}"/>
                            </Select>

                            <Label text="Mobile Number"/>
                            <HBox alignItems="Center" wrap="Wrap">
                                <Select id="mobileCodeSelect" selectedKey="{wizardData>/MobileCountryCode}" width="110px" items="{path: '/VH_MobileCountryCode', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                    <core:Item key="{code}" text="{code}"/>
                                </Select>
                                <Input id="mobileInput" value="{wizardData>/MobileNumber}" placeholder="Digits only" width="170px" class="sapUiSmallMarginBegin" editable="{= !${wizardData>/isReadOnly} }"/>
                            </HBox>
                            
                            <Label text="Telephone"/>
                            <Input value="{wizardData>/Telephone}" placeholder="Landline, Office, etc." editable="{= !${wizardData>/isReadOnly} }"/>

                            <Label text="Email" required="true"/>
                            <Input id="emailInput" value="{wizardData>/Email}" type="Email" placeholder="user@example.com" editable="{= !${wizardData>/isReadOnly} }"/>
                        </form:SimpleForm>
                        <HBox justifyContent="SpaceBetween" class="sapUiMediumMarginTop">
                            <Button text="Previous" type="Transparent" press="onPrevStep" />
                            <Button text="Step 3" type="Emphasized" press="onNextStep" />
                        </HBox>
                    </WizardStep>

                    <WizardStep id="step3" title="Identification" icon="sap-icon://loan" validated="true">
                        <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12" columnsXL="2" columnsL="2" columnsM="1">
                            <core:Title text="3. Tax Information"/>
                            
                            <Label text="Tax Category" required="true"/>
                            <Select id="taxCategorySelect" selectedKey="{wizardData>/TaxCategory}" items="{path: '/VH_TaxCategory', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                <core:Item key="{code}" text="{code} - {name}"/>
                            </Select>
                            
                            <Label text="Tax Number"/>
                            <Input id="taxNumberInput" value="{wizardData>/TaxNumber}" placeholder="TIN / Tax ID Number" editable="{= !${wizardData>/isReadOnly} }"/>

                            <Label text="Tax Status"/>
                            <Select selectedKey="{wizardData>/TaxStatus}" items="{path: '/VH_TaxStatus', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                <core:Item key="{code}" text="{name}"/>
                            </Select>
                        </form:SimpleForm>
                        <HBox justifyContent="SpaceBetween" class="sapUiMediumMarginTop">
                            <Button text="Previous" type="Transparent" press="onPrevStep" />
                            <Button text="Step 4" type="Emphasized" press="onNextStep" />
                        </HBox>
                    </WizardStep>

                    <WizardStep id="step4" title="Company Details (FLCU00)" icon="sap-icon://factory" validated="true">
                        <VBox>
                            <Table items="{wizardData>/CompanyCodes}" noDataText="No Company Codes defined. Click '+' to add.">
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="Company Code Assignments"/>
                                        <ToolbarSpacer />
                                        <Button icon="sap-icon://add" text="Add Company Code" press="onAddCompanyCode" type="Ghost" visible="{= !${wizardData>/isReadOnly} }"/>
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column><Text text="Company Code"/></Column>
                                    <Column><Text text="Is BP"/></Column>
                                    <Column><Text text="Is Customer"/></Column>
                                    <Column hAlign="End" width="50px" visible="{= !${wizardData>/isReadOnly} }"></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Select selectedKey="{wizardData>CompanyCode}" items="{path: '/VH_CompanyCode', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                                <core:Item key="{code}" text="{code} - {name}"/>
                                            </Select>
                                            <CheckBox selected="{wizardData>IsBP}" editable="{= !${wizardData>/isReadOnly} }"/>
                                            <CheckBox selected="{wizardData>IsCustomer}" editable="{= !${wizardData>/isReadOnly} }"/>
                                            <Button icon="sap-icon://delete" type="Reject" press="onRemoveCompanyCode" visible="{= !${wizardData>/isReadOnly} }"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                            
                            <IconTabBar items="{wizardData>/CompanyCodes}" expandable="false" applyContentPadding="false" class="sapUiMediumMarginTop">
                                <items>
                                    <IconTabFilter icon="sap-icon://factory" text="CC: {wizardData>CompanyCode}" design="Horizontal">
                                        <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12" columnsXL="2" columnsL="2" columnsM="1">
                                            <core:Title text="Account Management"/>
                                            <Label text="Reconciliation Account"/>
                                            <Select selectedKey="{wizardData>ReconciliationAccount}" items="{path: '/VH_ReconciliationAccount', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                                <core:Item key="{code}" text="{code} - {name}"/>
                                            </Select>
                                        </form:SimpleForm>
                                    </IconTabFilter>
                                </items>
                            </IconTabBar>
                        </VBox>
                        <HBox justifyContent="SpaceBetween" class="sapUiMediumMarginTop">
                            <Button text="Previous" type="Transparent" press="onPrevStep" />
                            <HBox>
                                <Button text="Skip" icon="sap-icon://journey-depart" type="Ghost" press="onSkipStep" class="sapUiSmallMarginEnd" visible="{= !${wizardData>/isReadOnly} }" />
                                <Button text="Step 5" type="Emphasized" press="onNextStep" />
                            </HBox>
                        </HBox>
                    </WizardStep>

                    <WizardStep id="step5" title="Sales Area (FLCU01)" icon="sap-icon://sales-order" validated="true">
                        <VBox>
                            <Table items="{wizardData>/SalesAreas}" noDataText="No Sales Areas defined. Click '+' to add.">
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="Sales Area Assignments"/>
                                        <ToolbarSpacer />
                                        <Button icon="sap-icon://add" text="Add Sales Area" press="onAddSalesArea" type="Ghost" visible="{= !${wizardData>/isReadOnly} }"/>
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column><Text text="Sales Organization"/></Column>
                                    <Column><Text text="Distribution Channel"/></Column>
                                    <Column><Text text="Division"/></Column>
                                    <Column hAlign="End" width="50px" visible="{= !${wizardData>/isReadOnly} }"></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Select selectedKey="{wizardData>SalesOrganization}" items="{path: '/VH_SalesOrganization', parameters: {$filter: 'isActive eq true'}}" change="onSalesOrgChange" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                                <core:Item key="{code}" text="{code} - {name}"/>
                                            </Select>
                                            <Select selectedKey="{wizardData>DistributionChannel}" items="{path: '/VH_DistributionChannel', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                                <core:Item key="{code}" text="{code} - {name}"/>
                                            </Select>
                                            <Select selectedKey="{wizardData>Division}" items="{path: '/VH_Division', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                                <core:Item key="{code}" text="{code} - {name}"/>
                                            </Select>
                                            <Button icon="sap-icon://delete" type="Reject" press="onRemoveSalesArea" visible="{= !${wizardData>/isReadOnly} }"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                        <HBox justifyContent="SpaceBetween" class="sapUiMediumMarginTop">
                            <Button text="Previous" type="Transparent" press="onPrevStep" />
                            <HBox>
                                <Button text="Skip" icon="sap-icon://journey-depart" type="Ghost" press="onSkipStep" class="sapUiSmallMarginEnd" visible="{= !${wizardData>/isReadOnly} }" />
                                <Button text="Step 6" type="Emphasized" press="onNextStep" />
                            </HBox>
                        </HBox>
                    </WizardStep>

                    <WizardStep id="step6" title="Customer Info" icon="sap-icon://money-bills" validated="true">
                        <IconTabBar items="{wizardData>/SalesAreas}" expandable="false" applyContentPadding="false">
                            <items>
                                <IconTabFilter icon="sap-icon://org-chart" text="Sales Org: {wizardData>SalesOrganization}" design="Horizontal">
                                    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12" columnsXL="2" columnsL="2" columnsM="1">
                                        <core:Title text="Sales Logic"/>
                                        
                                        <Label text="Customer Group"/>
                                        <Select selectedKey="{wizardData>CustomerGroup}" items="{path: '/VH_CustomerGroup', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                            <core:Item key="{code}" text="{code} - {name}"/>
                                        </Select>
                                        
                                        <Label text="Currency (Auto)"/>
                                        <Input value="{wizardData>Currency}" editable="false"/>
                                        
                                        <Label text="Exchange Rate Type (Auto)"/>
                                        <Input value="{wizardData>ExchangeRateType}" editable="false"/>
 
                                        <Label text="Pricing Procedure (Auto)"/>
                                        <Input value="{wizardData>CustomerPricingProcedure}" editable="false"/>
 
                                        <Label text="Statistics Group (Auto)"/>
                                        <Input value="{wizardData>CustomerStatsGroup}" editable="false"/>
 
                                        <core:Title text="Billing &amp; Tax"/>
 
                                        <Label text="Payment Terms (Auto)"/>
                                        <Input value="{wizardData>PaymentTerms}" editable="false"/>
 
                                        <Label text="Incoterms (Auto)"/>
                                        <Input value="{wizardData>Incoterms}" editable="false"/>
 
                                        <Label text="Account Assignment Group"/>
                                        <Select selectedKey="{wizardData>AccountAssignmentGroup}" items="{path: '/VH_AccountAssignmentGroup', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                            <core:Item key="{code}" text="{code} - {name}"/>
                                        </Select>
 
                                        <Label text="Tax Classification"/>
                                        <Select selectedKey="{wizardData>TaxClassification}" items="{path: '/VH_TaxClassification', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                            <core:Item key="{code}" text="{code} - {name}"/>
                                        </Select>
 
                                        <Label text="Output Tax Country (Auto)"/>
                                        <Input value="{wizardData>OutputTaxCountry}" editable="false"/>
 
                                        <Label text="Output Tax Category (Auto)"/>
                                        <Input value="{wizardData>OutputTaxCategory}" editable="false"/>
 
                                        <Label text="Customer Data 2"/>
                                        <Select selectedKey="{wizardData>CustomerData2}" items="{path: '/VH_CustomerData2', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                            <core:Item key="{code}" text="{code} - {name}"/>
                                        </Select>
                                    </form:SimpleForm>
                                </IconTabFilter>
                            </items>
                        </IconTabBar>
                        <HBox justifyContent="SpaceBetween" class="sapUiMediumMarginTop">
                            <Button text="Previous" type="Transparent" press="onPrevStep" />
                            <HBox>
                                <Button text="Skip" icon="sap-icon://journey-depart" type="Ghost" press="onSkipStep" class="sapUiSmallMarginEnd" visible="{= !${wizardData>/isReadOnly} }" />
                                <Button text="Step 7" type="Emphasized" press="onNextStep" />
                            </HBox>
                        </HBox>
                    </WizardStep>
 
                    <WizardStep id="step7" title="UKM000 SAP Credit Management" icon="sap-icon://collections-insight" validated="true">
                        <VBox>
                            <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12" columnsXL="2" columnsL="2" columnsM="1">
                                <core:Title text="Credit Profile"/>
                                
                                <Label text="Risk Class"/>
                                <Select selectedKey="{wizardData>/RiskClass}" items="{path: '/VH_RiskClass', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                    <core:Item key="{code}" text="{code} - {name}"/>
                                </Select>
                                
                                <Label text="Check Rule"/>
                                <Select selectedKey="{wizardData>/CheckRule}" items="{path: '/VH_CheckRule', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                    <core:Item key="{code}" text="{code} - {name}"/>
                                </Select>
 
                                <Label text="Credit Group"/>
                                <Select selectedKey="{wizardData>/CreditGroup}" items="{path: '/VH_CreditGroup', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                    <core:Item key="{code}" text="{code} - {name}"/>
                                </Select>
                            </form:SimpleForm>

                            <Table items="{wizardData>/CreditSegments}" noDataText="No Credit Segment data. Click '+' to add." class="sapUiMediumMarginTop">
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="Credit Limit and Control"/>
                                        <ToolbarSpacer />
                                        <Button icon="sap-icon://add" text="Add Segment" press="onAddCreditSegment" type="Ghost" visible="{= !${wizardData>/isReadOnly} }"/>
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column><Text text="Credit Segment"/></Column>
                                    <Column><Text text="Rules"/></Column>
                                    <Column><Text text="Limit Defined"/></Column>
                                    <Column><Text text="Limit"/></Column>
                                    <Column><Text text="Currency"/></Column>
                                    <Column><Text text="Valid To"/></Column>
                                    <Column hAlign="End" width="50px" visible="{= !${wizardData>/isReadOnly} }"></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Select selectedKey="{wizardData>CreditSegment}" items="{path: '/VH_CreditSegment', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                                <core:Item key="{code}" text="{code} - {name}"/>
                                            </Select>
                                            <Select selectedKey="{wizardData>CreditLimitRules}" items="{path: '/VH_CreditLimitRule', parameters: {$filter: 'isActive eq true'}}" forceSelection="false" editable="{= !${wizardData>/isReadOnly} }">
                                                <core:Item key="{code}" text="{code} - {name}"/>
                                            </Select>
                                            <RadioButtonGroup columns="2" selectedIndex="{= ${wizardData>LimitDefined} ? 0 : 1 }" editable="{= !${wizardData>/isReadOnly} }" select="onLimitDefinedChange">
                                                <RadioButton text="Defined" />
                                                <RadioButton text="Not Defined" />
                                            </RadioButtonGroup>
                                            <Input value="{wizardData>CreditLimit}" type="Number" placeholder="100" editable="{= !${wizardData>/isReadOnly} &amp;&amp; ${wizardData>LimitDefined} }"/>
                                            <Input value="{wizardData>LimitCurrency}" editable="false" width="70px"/>
                                            <DatePicker value="{wizardData>ValidityDate}" valueFormat="yyyy-MM-dd" displayFormat="medium" editable="{= !${wizardData>/isReadOnly} }"/>
                                            <Button icon="sap-icon://delete" type="Reject" press="onRemoveCreditSegment" visible="{= !${wizardData>/isReadOnly} }"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                        <HBox justifyContent="SpaceBetween" class="sapUiMediumMarginTop">
                            <Button text="Previous" type="Transparent" press="onPrevStep" />
                            <HBox>
                                <Button text="Skip" icon="sap-icon://journey-depart" type="Ghost" press="onSkipStep" class="sapUiSmallMarginEnd" visible="{= !${wizardData>/isReadOnly} }" />
                                <Button text="Review &amp; Submit" type="Accept" press="onOpenReview" />
                            </HBox>
                        </HBox>
                    </WizardStep>

                </Wizard>
            </VBox>
        </content>
    </Page>

    <Dialog id="reviewDialog"
            title="Review &amp; Submit"
            contentWidth="800px"
            draggable="true"
            resizable="true">
        <content>
            <VBox class="sapUiMediumMargin">
                <MessageStrip text="Review all data before submitting." type="Warning" showIcon="true" class="sapUiSmallMarginBottom"/>
                <form:SimpleForm layout="ColumnLayout" columnsL="2" columnsM="2" editable="false">
                    <core:Title text="General Data"/>
                    <Label text="BP Role"/><Text text="{wizardData>/BPRole}"/>
                    <Label text="Category"/><Text text="{wizardData>/BusinessPartnerCategory}"/>
                    <Label text="Type"/><Text text="{wizardData>/BPType}"/>
                    <Label text="Grouping"/><Text text="{wizardData>/Grouping}"/>
                    
                    <core:Title text="Address"/>
                    <Label text="Title"/><Text text="{wizardData>/Title}"/>
                    <Label text="Name"/><Text text="{wizardData>/Name}"/>
                    <Label text="Search Terms"/><Text text="{wizardData>/SearchTerm1} / {wizardData>/SearchTerm2}"/>
                    <core:Title text="Credit Profile"/>
                    <Label text="Risk Class"/><Text text="{wizardData>/RiskClass}"/>
                    <Label text="Check Rule"/><Text text="{wizardData>/CheckRule}"/>
                    <Label text="Credit Group"/><Text text="{wizardData>/CreditGroup}"/>
                </form:SimpleForm>
                

                <Title text="Sales Areas" level="H4" class="sapUiSmallMarginTop"/>
                <Table items="{wizardData>/SalesAreas}">
                    <columns>
                        <Column><Text text="Sales Org"/></Column>
                        <Column><Text text="Dist Channel"/></Column>
                        <Column><Text text="Division"/></Column>
                        <Column><Text text="Payment Terms"/></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{wizardData>SalesOrganization}"/>
                                <Text text="{wizardData>DistributionChannel}"/>
                                <Text text="{wizardData>Division}"/>
                                <Text text="{wizardData>PaymentTerms}"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <Title text="Company Codes" level="H4" class="sapUiSmallMarginTop"/>
                <Table items="{wizardData>/CompanyCodes}">
                    <columns>
                        <Column><Text text="Company Code"/></Column>
                        <Column><Text text="Reconciliation Account"/></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{wizardData>CompanyCode}"/>
                                <Text text="{wizardData>ReconciliationAccount}"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <Title text="Credit Segments" level="H4" class="sapUiSmallMarginTop"/>
                <Table items="{wizardData>/CreditSegments}">
                    <columns>
                        <Column><Text text="Segment"/></Column>
                        <Column><Text text="Limit"/></Column>
                        <Column><Text text="Currency"/></Column>
                        <Column><Text text="Valid To"/></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{wizardData>CreditSegment}"/>
                                <Text text="{wizardData>CreditLimit}"/>
                                <Text text="{wizardData>LimitCurrency}"/>
                                <Text text="{wizardData>ValidityDate}"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
        <buttons>
            <Button text="Cancel" press="onCloseReview" type="Transparent"/>
            <Button text="Submit for Creation" press="onWizardCompleted" type="Emphasized" icon="sap-icon://paper-plane" visible="{= !${wizardData>/isReadOnly} }"/>
        </buttons>
    </Dialog>
</mvc:View>