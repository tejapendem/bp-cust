{
  "name": "bp-cust",
  "version": "1.0.0",
  "description": "Business Partner Creation Wizard",
  "dependencies": {
    "@cap-js/sqlite": "^1.11.1",
    "@sap-cloud-sdk/connectivity": "^4.6.0",
    "@sap-cloud-sdk/mail-client": "^3.24.0",
    "@sap/cds": "^8",
    "@sap/xssec": "^4",
    "express": "^4",
    "nodemailer": "^6.10.1",
    "puppeteer": "^22.6.0"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9"
  },
  "cds": {
    "auto-deploy": true,
    "requires": {
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "alice": {
              "roles": [
                "admin",
                "Admin"
              ]
            },
            "rajesh.pendem@canopusgbs.com": {
              "roles": [
                "admin",
                "Admin"
              ]
            },
            "bob": {
              "roles": [
                "viewer"
              ]
            }
          }
        }
      },
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "bp-cust.sqlite"
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": "bp-cust.sqlite"
          },
          "deploy-on-start": true
        }
      },
      "html5-repo": true,
      "sap_process_automation_mail": {
        "kind": "mail"
      },
      "model": [
        "backend/db",
        "backend/srv"
      ]
    },
    "folders": {
      "db": "backend/db",
      "srv": "backend/srv",
      "app": "frontend"
    }
  },
  "scripts": {
    "start": "cds-serve",
    "deploy": "cds deploy --to sqlite:bp-cust.sqlite",
    "postinstall": "npx puppeteer browsers install chrome"
  }
}
