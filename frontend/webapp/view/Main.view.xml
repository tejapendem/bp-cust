<mvc:View controllerName="bp.cust.ui.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core">

    <Page showHeader="false" backgroundDesign="List" class="homePage">
        <content>
            <VBox class="hpOuterPadding">

                <!-- ========================================================
                     Restricted Access (Guest)
                     ======================================================== -->
                <VBox visible="{= ${userModel>/role} === 'guest' }" alignItems="Center" justifyContent="Center" class="hpGuestCard">
                    <FlexBox justifyContent="Center" alignItems="Center" class="hpGuestIcon">
                        <core:Icon src="sap-icon://locked" size="2.5rem" color="#7B5EA7" />
                    </FlexBox>
                    <Title text="Access Restricted" level="H2" class="hpGuestTitle sapUiSmallMarginTop" />
                    <Text text="You are currently signed in as a Guest. Access to the Business Partner Directory is restricted." class="hpGuestText sapUiSmallMarginTop sapUiMediumMarginBottom" />
                    <Button text="Request Access" press="onManageAccessPress" icon="sap-icon://key" class="hpRequestBtn" />
                </VBox>

                <!-- ========================================================
                     Authenticated user content
                     ======================================================== -->
                <VBox visible="{= ${userModel>/role} !== 'guest' }">

                    <!-- ── Page Header ──────────────────────────────────── -->
                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="hpPageHeader">
                        <HBox alignItems="Center">
                            <FlexBox justifyContent="Center" alignItems="Center" class="hpHeaderIcon">
                                <Text text="{= ${userModel>/name} ? ${userModel>/name}.charAt(0).toUpperCase() : '?' }" class="hpHeaderInitial" />
                            </FlexBox>
                            <VBox class="sapUiSmallMarginBegin">
                                <HBox alignItems="Baseline">
                                    <Title text="Hello, " level="H2" class="hpGreetingPrefix" />
                                    <Title text="{= ${userModel>/name} ? ${userModel>/name}.split(' ')[0] : 'there' }" level="H2" class="hpGreetingName" />
                                    <Title text="!" level="H2" class="hpGreetingPrefix" />
                                </HBox>
                                <Text text="Welcome to the Business Partner Directory — search, filter and manage all partners" class="hpPageSubtitle" />
                            </VBox>
                        </HBox>
                        <Button text="Create Business Partner" icon="sap-icon://add" press="onCreatepress" class="hpCreateBtn" />
                    </HBox>

                    <!-- ── Filter Card ──────────────────────────────────── -->
                    <VBox class="hpCard hpFilterCard sapUiSmallMarginTop">
                        <HBox alignItems="Center" class="hpCardHeader">
                            <FlexBox justifyContent="Center" alignItems="Center" class="hpCardIcon hpIconBlue">
                                <core:Icon src="sap-icon://filter" size="1rem" color="#1565c0" />
                            </FlexBox>
                            <Title text="Filters" level="H4" class="sapUiSmallMarginBegin hpCardTitle" />
                        </HBox>
                        <VBox class="hpFilterBody">
                            <fb:FilterBar id="filterbar" search="onSearch" clear="onClear" showClearOnFB="true" useToolbar="false" showAdaptFiltersButton="true">
                                <fb:filterGroupItems>

                                    <fb:FilterGroupItem groupName="G1" name="LifecycleStatus" label="Status" visibleInFilterBar="true">
                                        <fb:control>
                                            <MultiInput id="filterStatus"
                                                placeholder="Select status..."
                                                showValueHelp="true"
                                                valueHelpRequest=".onOpenValueHelp"
                                                submit=".onMultiInputSubmit"
                                                showSuggestion="false">
                                                <customData>
                                                    <core:CustomData key="vhKey" value="status" writeToDom="false" />
                                                </customData>
                                            </MultiInput>
                                        </fb:control>
                                    </fb:FilterGroupItem>

                                    <fb:FilterGroupItem groupName="G1" name="Grouping" label="Grouping" visibleInFilterBar="true">
                                        <fb:control>
                                            <MultiInput id="filterGrouping"
                                                placeholder="Select grouping..."
                                                showValueHelp="true"
                                                valueHelpRequest=".onOpenValueHelp"
                                                submit=".onMultiInputSubmit"
                                                showSuggestion="false">
                                                <customData>
                                                    <core:CustomData key="vhKey" value="grouping" writeToDom="false" />
                                                </customData>
                                            </MultiInput>
                                        </fb:control>
                                    </fb:FilterGroupItem>

                                    <fb:FilterGroupItem groupName="G1" name="CompanyCode" label="Company Code" visibleInFilterBar="true">
                                        <fb:control>
                                            <MultiInput id="filterCompanyCode"
                                                placeholder="Select company code..."
                                                showValueHelp="true"
                                                valueHelpRequest=".onOpenValueHelp"
                                                submit=".onMultiInputSubmit"
                                                showSuggestion="false">
                                                <customData>
                                                    <core:CustomData key="vhKey" value="companyCode" writeToDom="false" />
                                                </customData>
                                            </MultiInput>
                                        </fb:control>
                                    </fb:FilterGroupItem>

                                    <fb:FilterGroupItem groupName="G1" name="SalesOrganization" label="Sales Organization" visibleInFilterBar="true">
                                        <fb:control>
                                            <MultiInput id="filterSalesOrg"
                                                placeholder="Select sales org..."
                                                showValueHelp="true"
                                                valueHelpRequest=".onOpenValueHelp"
                                                submit=".onMultiInputSubmit"
                                                showSuggestion="false">
                                                <customData>
                                                    <core:CustomData key="vhKey" value="salesOrg" writeToDom="false" />
                                                </customData>
                                            </MultiInput>
                                        </fb:control>
                                    </fb:FilterGroupItem>

                                    <fb:FilterGroupItem groupName="G1" name="BusinessPartnerNumber" label="Business Partner ID" visibleInFilterBar="false">
                                        <fb:control>
                                            <MultiInput id="filterBPNumber"
                                                placeholder="Enter or select BP ID..."
                                                showValueHelp="true"
                                                valueHelpRequest=".onOpenValueHelp"
                                                submit=".onMultiInputSubmit"
                                                showSuggestion="false">
                                                <customData>
                                                    <core:CustomData key="vhKey" value="bpNumber" writeToDom="false" />
                                                </customData>
                                            </MultiInput>
                                        </fb:control>
                                    </fb:FilterGroupItem>

                                    <fb:FilterGroupItem groupName="G1" name="Name" label="Name" visibleInFilterBar="false">
                                        <fb:control>
                                            <MultiInput id="filterName"
                                                placeholder="Enter or select name..."
                                                showValueHelp="true"
                                                valueHelpRequest=".onOpenValueHelp"
                                                submit=".onMultiInputSubmit"
                                                showSuggestion="false">
                                                <customData>
                                                    <core:CustomData key="vhKey" value="name" writeToDom="false" />
                                                </customData>
                                            </MultiInput>
                                        </fb:control>
                                    </fb:FilterGroupItem>

                                    <fb:FilterGroupItem groupName="G1" name="Category" label="Category" visibleInFilterBar="false">
                                        <fb:control>
                                            <MultiInput id="filterCategory"
                                                placeholder="Select category..."
                                                showValueHelp="true"
                                                valueHelpRequest=".onOpenValueHelp"
                                                submit=".onMultiInputSubmit"
                                                showSuggestion="false">
                                                <customData>
                                                    <core:CustomData key="vhKey" value="category" writeToDom="false" />
                                                </customData>
                                            </MultiInput>
                                        </fb:control>
                                    </fb:FilterGroupItem>

                                </fb:filterGroupItems>
                            </fb:FilterBar>
                        </VBox>
                    </VBox>

                    <!-- ── Table Card ───────────────────────────────────── -->
                    <VBox class="hpCard sapUiSmallMarginTop sapUiMediumMarginBottom">
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="hpCardHeader">
                            <HBox alignItems="Center">
                                <FlexBox justifyContent="Center" alignItems="Center" class="hpCardIcon hpIconGreen">
                                    <core:Icon src="sap-icon://group" size="1rem" color="#2e7d32" />
                                </FlexBox>
                                <Title text="Available Partners" level="H4" class="sapUiSmallMarginBegin hpCardTitle" />
                            </HBox>
                            <HBox alignItems="Center">
                                <Button icon="sap-icon://refresh" type="Transparent" press="onRefresh" tooltip="Refresh Data" class="hpToolbarBtn" />
                                <Button id="mainSortBtn" icon="sap-icon://sort-descending" type="Transparent" press="onToggleSort" tooltip="Sort newest first" class="hpToolbarBtn" />
                                <Button icon="sap-icon://delete" type="Transparent" text="Delete"
                                    visible="{userModel>/isAdmin}"
                                    press="onDeleteSelected"
                                    tooltip="Delete selected BPs"
                                    class="hpDeleteBtn sapUiTinyMarginBegin" />
                                <Button icon="sap-icon://action-settings" type="Transparent" press="onColumnSettings" />
                            </HBox>
                        </HBox>

                        <Table id="bpTable"
                            mode="MultiSelect"
                            items="{ path: '/BusinessPartners', sorter: { path: 'createdAt', descending: true } }"
                            sticky="ColumnHeaders"
                            autoPopinMode="true"
                            showSeparators="Inner"
                            busyIndicatorDelay="0"
                            noDataText="No business partners found. Adjust your filters or create a new one."
                            class="hpTable">

                            <columns>
                                <Column width="22%"><Text text="Business Partner" /></Column>
                                <Column width="15%" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Block"><Text text="SAP Number" /></Column>
                                <Column width="110px" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline"><Text text="Type" /></Column>
                                <Column width="110px" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline"><Text text="Grouping" /></Column>
                                <Column width="160px" demandPopin="true" minScreenWidth="Phone" popinDisplay="Inline"><Text text="Status" /></Column>
                                <Column width="170px" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Block"><Text text="Created" /></Column>
                                <Column demandPopin="true" minScreenWidth="Desktop" popinDisplay="Block"><Text text="Assigned Roles" /></Column>
                            </columns>

                            <items>
                                <ColumnListItem type="Navigation" press="onItemPress" class="hpTableRow">
                                    <cells>

                                        <!-- BP Details -->
                                        <HBox alignItems="Center">
                                            <FlexBox justifyContent="Center" alignItems="Center" class="hpAvatar">
                                                <Text text="{= ${Name} ? ${Name}.charAt(0).toUpperCase() : '?' }" class="hpAvatarText" />
                                            </FlexBox>
                                            <VBox class="sapUiSmallMarginBegin">
                                                <Text text="{Name}" class="hpBpName" />
                                                <Text text="ID: {BusinessPartnerNumber}" class="hpBpId" />
                                            </VBox>
                                        </HBox>

                                        <!-- SAP Number -->
                                        <Text text="{SAPBPNumber}" class="adSapBpBadge" />

                                        <!-- Type -->
                                        <HBox justifyContent="Center">
                                            <Text text="{BPType}" class="hpTypeBadge" />
                                        </HBox>

                                        <!-- Grouping -->
                                        <HBox justifyContent="Center">
                                            <Text text="{Grouping}" class="{= ${Grouping} === 'ZP01' ? 'hpGroupingPrimary' : 'hpGroupingSecondary' }" />
                                        </HBox>

                                        <!-- Status -->
                                        <HBox alignItems="Center">
                                            <Text text="{= ${SAPPushStatus} === 'Pushed' ? 'Pushed' : (${LifecycleStatus} === 'draft' ? 'Draft' : (${LifecycleStatus} === 'pending_approval' ? 'Pending Approval' : 'Active')) }"
                                                class="{= ${SAPPushStatus} === 'Pushed' ? 'hpStatusPushed' : (${LifecycleStatus} === 'draft' ? 'hpStatusDraft' : (${LifecycleStatus} === 'pending_approval' ? 'hpStatusPending' : 'hpStatusActive')) }" />
                                        </HBox>

                                        <!-- Created -->
                                        <HBox alignItems="Center">
                                            <core:Icon src="sap-icon://calendar" class="sapUiTinyMarginEnd hpDateIcon" color="#1565c0" />
                                            <Text text="{path: 'createdAt', formatter: '.formatDate'}" class="hpDateText" />
                                        </HBox>

                                        <!-- Assigned Roles -->
                                        <HBox wrap="Wrap" class="hpRolesCell">
                                            <Text text="FLCU01" class="hpRoleBadge hpRoleSales" />
                                            <Text text="FLCU00" class="hpRoleBadge hpRoleCompany" />
                                            <Text text="{= ${BPRole} === '000000' ? 'UKM000' : ${BPRole} }" class="hpRoleBadge hpRoleCredit" />
                                        </HBox>

                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>

                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
