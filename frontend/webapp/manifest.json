{
  "_version": "1.49.0",
  "sap.app": {
    "id": "bp.cust.ui",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "/service/bpcust/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://customer",
      "favIcon": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "bp.cust.ui.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.f": {},
        "sap.ui.layout": {},
        "sap.ui.comp": {},
        "sap.suite.ui.microchart": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "bp.cust.ui.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "bp.cust.ui.view",
        "controlAggregation": "pages",
        "controlId": "appContainer",
        "clearControlAggregation": false
      },
      "routes": [
        {
          "name": "Main",
          "pattern": "",
          "target": [
            "TargetMain"
          ]
        },
        {
          "name": "Wizard",
          "pattern": "create",
          "target": [
            "TargetWizard"
          ]
        },

        {
          "name": "WizardEdit",
          "pattern": "edit/{bpID}",
          "target": [
            "TargetWizard"
          ]
        },
        {
          "name": "Admin",
          "pattern": "admin",
          "target": [
            "TargetAdmin"
          ]
        }
      ],
      "targets": {
        "TargetMain": {
          "viewType": "XML",
          "viewName": "Main"
        },
        "TargetWizard": {
          "viewType": "XML",
          "viewName": "Wizard"
        },
        "TargetAdmin": {
          "viewType": "XML",
          "viewName": "Admin"
        }
      }
    }
  }
}