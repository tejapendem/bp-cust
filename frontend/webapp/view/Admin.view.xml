<mvc:View controllerName="bp.cust.ui.controller.Admin"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page showHeader="false" backgroundDesign="List" class="userMgmtPage">
        <content>
            <VBox class="umOuterPadding">

                <!-- ── Page Header ──────────────────────────────────── -->
                <HBox alignItems="Center" justifyContent="SpaceBetween" class="umPageHeader">
                    <HBox alignItems="Center">
                        <core:Icon src="sap-icon://group" size="2.5rem" color="#7B5EA7" class="umHeaderIcon" />
                        <VBox class="sapUiSmallMarginBegin">
                            <Title text="User Management" level="H2" class="umPageTitle" />
                            <Text text="Manage users, roles, and access requests" class="umPageSubtitle" />
                        </VBox>
                    </HBox>
                    <HBox>
                        <Button icon="sap-icon://action-settings" text="Configure Approval Levels" type="Transparent" press=".onConfigureApprovalLevels" class="umNavBtn sapUiSmallMarginEnd" />
                        <Button icon="sap-icon://inbox" text="Approval Inbox" type="Transparent" press=".onApprovalInbox" class="umNavBtn sapUiSmallMarginEnd" />
                        <Button icon="sap-icon://refresh" text="Refresh" type="Transparent" press=".onRefreshUsers" class="umRefreshBtn" />
                    </HBox>
                </HBox>

                <!-- ── Users Card ───────────────────────────────────── -->
                <VBox class="umCard sapUiMediumMarginTop sapUiMediumMarginBottom">
                    <HBox alignItems="Center" class="umCardHeader umCardHeaderUsers">
                        <FlexBox justifyContent="Center" alignItems="Center" class="umCardIconCircle umIconUsers">
                            <core:Icon src="sap-icon://employee" size="1.2rem" color="#1565c0" />
                        </FlexBox>
                        <Title text="Users" level="H3" class="sapUiSmallMarginBegin" />
                    </HBox>

                    <Table id="userTable"
                        items="{ path: '/Users' }"
                        growing="true"
                        growingThreshold="20"
                        busyIndicatorDelay="0"
                        noDataText="No users found. Users appear here automatically when they log in with an assigned role collection."
                        mode="None"
                        showSeparators="Inner"
                        class="umTable">
                        <columns>
                            <Column width="30%"><Text text="Name" /></Column>
                            <Column width="120px"><Text text="Role" /></Column>
                            <Column><Text text="Email" /></Column>
                            <Column width="110px" hAlign="Center"><Text text="Status" /></Column>
                            <Column width="170px"><Text text="Last Login" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem class="umTableRow">
                                <cells>
                                    <HBox alignItems="Center">
                                        <FlexBox justifyContent="Center" alignItems="Center" class="umAvatar">
                                            <Text text="{= ${name} ? ${name}.charAt(0).toUpperCase() : '?' }" class="umAvatarText" />
                                        </FlexBox>
                                        <Text text="{name}" class="umUserName sapUiSmallMarginBegin" />
                                    </HBox>
                                    <Text
                                        text="{= ${role} === 'admin' ? 'Admin' : 'Viewer' }"
                                        class="{= ${role} === 'admin' ? 'umRoleBadgeAdmin' : 'umRoleBadgeViewer' }" />
                                    <Text text="{email}" class="umEmailText" />
                                    <HBox justifyContent="Center">
                                        <Text
                                            text="{status}"
                                            class="{= ${status} === 'active' ? 'umStatusActive' : 'umStatusInactive' }" />
                                    </HBox>
                                    <Text text="{path: 'modifiedAt', formatter: '.formatDate'}" class="umDateText" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
