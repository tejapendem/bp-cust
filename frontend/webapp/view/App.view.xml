<mvc:View controllerName="bp.cust.ui.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <tnt:ToolPage id="toolPage" class="appToolPage">
        <tnt:header>
            <tnt:ToolHeader class="appToolHeader" visible="{userModel>/showAppHeader}">
                <Button id="sideNavigationToggleButton" icon="sap-icon://menu2" type="Transparent" press=".onSideNavButtonPress" class="appMenuBtn" />
                <ToolbarSpacer width="10px" />
                <Image src="https://www.sap.com/dam/application/shared/logos/sap-logo-svg.svg" height="1.5rem" />
                <Title text="Business Partner" level="H1" class="appBrandTitle" />
                <ToolbarSpacer />
                <Switch id="themeSwitch" state="false" customTextOn="Dark" customTextOff="Light" change=".onThemeSwitch" class="sapUiSmallMarginEnd appThemeSwitch" tooltip="Toggle Dark Mode" />
                <Button icon="sap-icon://bell" type="Transparent" class="appBellBtn" />
                <Avatar id="profileAvatar" displaySize="XS" initials="{userModel>/initials}" press=".onProfilePress" class="sapUiSmallMarginEnd appAvatar" />
            </tnt:ToolHeader>
        </tnt:header>
        <tnt:sideContent>
            <tnt:SideNavigation id="sideNavigation" selectedKey="home" itemSelect=".onItemSelect" class="appSideNav">
                <tnt:NavigationList>
                    <tnt:NavigationListItem text="Home" icon="sap-icon://home" key="home" />
                    <tnt:NavigationListItem text="Create Business Partner" icon="sap-icon://create" key="createBP" />
                    <tnt:NavigationListItem text="Admin Dashboard" icon="sap-icon://manager-insight" key="dashboard" visible="{userModel>/isAdmin}" />
                    <tnt:NavigationListItem text="Activation Queue" icon="sap-icon://activate" key="queue" visible="{userModel>/isAdmin}" />
                    <tnt:NavigationListItem text="User Management" icon="sap-icon://group" key="admin" visible="{userModel>/isAdmin}" />
                    <tnt:NavigationListItem text="Approval Workflow" icon="sap-icon://action-settings" key="approvalLevels" visible="{userModel>/isAdmin}" />
                    <tnt:NavigationListItem text="{= 'Approval Inbox' + (${userModel>/pendingApprovals} > 0 ? '  •  ' + ${userModel>/pendingApprovals} : '') }" icon="sap-icon://inbox" key="approvalInbox" visible="{userModel>/isAdmin}" />
                    <tnt:NavigationListItem text="Approval Data" icon="sap-icon://accept" key="approvalData" visible="{userModel>/isAdmin}" />
                </tnt:NavigationList>
                <tnt:fixedItem>
                    <tnt:NavigationList>
                        <tnt:NavigationListItem visible="{userModel>/showSidebarToggle}" icon="sap-icon://close-command-field" text="Collapse Sidebar" key="_collapse" />
                    </tnt:NavigationList>
                </tnt:fixedItem>
            </tnt:SideNavigation>
        </tnt:sideContent>
        <tnt:mainContents>
            <App id="appContainer" />
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>
