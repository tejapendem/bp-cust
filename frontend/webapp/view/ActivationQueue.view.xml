                            <Title text="Manage Groupings" level="H3" class="sapUiSmallMarginBottom" />
                            <Table id="groupingTable" items="{path: '/VH_Grouping'}">
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <ToolbarSpacer/>
                                        <Button icon="sap-icon://add" text="Add Grouping" press="onAddVH('VH_Grouping')" />
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column><Text text="Code"/></Column>
                                    <Column><Text text="Name"/></Column>
                                    <Column hAlign="Center" width="80px"><Text text="Active"/></Column>
                                    <Column hAlign="End" width="100px"><Text text="Actions"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{code}"/>
                                            <Text text="{name}"/>
                                            <Switch state="{isActive}" change="onToggleActive" />
                                            <HBox>
                                                <Button icon="sap-icon://edit" type="Transparent" press="onEditVH" />
                                                <Button icon="sap-icon://delete" type="Transparent" press="onDeleteVH" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </WizardStep>

