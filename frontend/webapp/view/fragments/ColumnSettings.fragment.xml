<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:layout="sap.ui.layout">
    <Dialog
        title="Column Settings"
        contentWidth="620px"
        resizable="true"
        draggable="true"
        showHeader="false"
        class="csDialog">

        <content>
            <VBox class="csContainer">

                <!-- ── Header ────────────────────────────────────── -->
                <HBox alignItems="Center" justifyContent="SpaceBetween" class="csHeader">
                    <HBox alignItems="Center">
                        <FlexBox justifyContent="Center" alignItems="Center" class="csHeaderIcon">
                            <core:Icon src="sap-icon://action-settings" size="1.3rem" color="#ffffff" />
                        </FlexBox>
                        <VBox class="sapUiSmallMarginBegin">
                            <Title text="Column Settings" level="H3" class="csHeaderTitle" />
                            <Text text="Customize visibility and sort order of table columns" class="csHeaderSubtitle" />
                        </VBox>
                    </HBox>
                </HBox>

                <!-- ── Column List ───────────────────────────────── -->
                <VBox class="csListWrapper">
                    <!-- Column titles -->
                    <HBox alignItems="Center" class="csListHead">
                        <Text text="COLUMN" class="csHeadCol csHeadColName" />
                        <Text text="VISIBLE" class="csHeadCol csHeadColVisible" />
                        <Text text="SORT ORDER" class="csHeadCol csHeadColSort" />
                    </HBox>

                    <List items="{colSettings>/}" growing="false" width="100%" showSeparators="None" class="csList">
                        <items>
                            <CustomListItem class="csListItem">
                                <HBox alignItems="Center" class="csRow">
                                    <!-- Name + Icon -->
                                    <HBox alignItems="Center" class="csRowName">
                                        <FlexBox justifyContent="Center" alignItems="Center" class="csRowIcon">
                                            <core:Icon src="sap-icon://table-column" size="0.9rem" color="#7c4dff" />
                                        </FlexBox>
                                        <Text text="{colSettings>label}" class="csRowLabel" />
                                    </HBox>

                                    <!-- Visibility Switch -->
                                    <HBox justifyContent="Center" class="csRowVisible">
                                        <Switch state="{colSettings>visible}" type="AcceptReject" class="csSwitch" />
                                    </HBox>

                                    <!-- Sort Direction -->
                                    <HBox justifyContent="Center" class="csRowSort">
                                        <SegmentedButton selectedKey="{colSettings>sort}" class="csSegmented">
                                            <items>
                                                <SegmentedButtonItem key="asc" icon="sap-icon://sort-ascending" tooltip="Ascending" />
                                                <SegmentedButtonItem key="desc" icon="sap-icon://sort-descending" tooltip="Descending" />
                                            </items>
                                        </SegmentedButton>
                                    </HBox>
                                </HBox>
                            </CustomListItem>
                        </items>
                    </List>
                </VBox>

            </VBox>
        </content>

        <buttons>
            <Button text="Cancel" press="onColSettingsCancel" class="csCancelBtn" />
            <Button text="Apply Changes" icon="sap-icon://accept" type="Emphasized" press="onColSettingsOK" class="csApplyBtn" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>