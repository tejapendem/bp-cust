<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog id="requestAccessDialog" title="Request Access">
        <content>
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
                <f:content>
                    <Label text="Requested Role" required="true" />
                    <Select id="requestedRole">
                        <core:Item key="admin" text="Admin" />
                        <core:Item key="viewer" text="Viewer" />
                    </Select>
                    <Label text="Reason" required="true" />
                    <TextArea id="requestReason" placeholder="Please provide a reason for the request..." rows="4" />
                </f:content>
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button text="Submit" type="Emphasized" press=".onSubmitRequest" />
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCancelRequest" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
