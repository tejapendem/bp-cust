{
  "name": "bp-cust",
  "version": "1.0.0",
  "description": "Business Partner Creation Wizard",
  "dependencies": {
    "@cap-js/sqlite": "^1.11.1",
    "@sap/cds": "^8",
    "@sap/xssec": "^4",
    "better-sqlite3": "^12.9.0",
    "express": "^4"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "bp-cust.sqlite"
        }
      },
      "[production]": {
        "auth": "xsuaa"
      },
      "html5-repo": true
    },
    "folders": {
      "db": "backend/db",
      "srv": "backend/srv",
      "app": "frontend"
    }
  },
  "scripts": {
    "start": "cds-serve",
    "deploy": "cds deploy --to sqlite:bp-cust.sqlite"
  }
}
